    "lint": "eslint .",
    "formato": "prettier --write .",
    "formato:revisar": "prettier --check .",
    "bd:migrar": "prisma migrate dev",
    "bd:generar": "prisma generate",
    "bd:estudio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.11",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
