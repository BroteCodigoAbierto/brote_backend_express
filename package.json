  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BroteCodigoAbierto/brote_backend_express.git"
  },
  "type": "module",
  "main": "src/servidor.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/servidor.ts",
    "start": "node --env-file-if-exists=.env src/servidor.ts",
