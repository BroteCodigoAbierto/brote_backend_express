// Esquema de la base de datos de Brote.
// Los modelos se agregan con el plan de cada feature (ver brote_specs).
// Convención: modelos y campos en español; tablas y columnas en snake_case
// con @@map y @map.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generado/prisma"
  // el código generado se importa como .ts, igual que el resto de la API
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth (F01). ÚNICA EXCEPCIÓN a los nombres en español: estos cuatro
// modelos se quedan como los define Better Auth 1.7 para no mantener un mapeo
// de campos con cada versión (ver brote_specs, plan de F01, "Excepciones").
// El contrato los traduce: User → Usuario (name → nombre, email → correo).
// ---------------------------------------------------------------------------

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  cursos                   Curso[] // F02: cursos de los que es autor (no crea columnas)
  progresos                Progreso[] // F04: lecciones completadas (no crea columnas)
  insignias                Insignia[] // F08: cursos completados con insignia (no crea columnas)
  membresiasOrganizacion   MiembroOrganizacion[] // F16: silos opcionales
  gruposDocente            Grupo[] // F16: grupos creados como docente
  membresiasGrupo          MiembroGrupo[] // F16: grupos donde participa como alumno
  reportesActividad        ReporteActividad[] // F16: reportes enviados

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Forma de entrar de un usuario; en el MVP solo "credential" (correo y contraseña)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Better Auth la exige aunque F01 no la usa (verificar correo, recuperar contraseña)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Cursos (F02) y actividades de las lecciones (F03). Los límites del título
// y la descripción llegan con F05.
// ---------------------------------------------------------------------------

model Curso {
  id            String     @id @default(uuid(7))
  titulo        String
  descripcion   String
  // solo los publicados se ven; lo pone en true un administrador en la base (decisión
  // 0014), y en false también su autor, al retirarlo del catálogo (F06)
  publicado     Boolean    @default(false)
  // F06: null, "pendiente" o "rechazada". Un trigger de la base limpia estos dos
  // campos cuando cambia `publicado`, y un CHECK valida sus valores (no se ven
  // aquí: están en la migración f06_revision_curso)
  revision      String?
  motivoRechazo String?    @map("motivo_rechazo")
  idAutor       String     @map("id_autor")
  // borrar cuentas está fuera del MVP: un autor con cursos no se puede borrar
  autor         User       @relation(fields: [idAutor], references: [id], onDelete: Restrict)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")
  lecciones     Leccion[]
  // F13: una de sus imágenes, que no sea GIF (lo comprueba el servicio). Si la imagen se
  // borra, el curso se queda con la portada generada
  idPortada     String?    @map("id_portada")
  portada       Imagen?    @relation("PortadaCurso", fields: [idPortada], references: [id], onDelete: SetNull)
  imagenes      Imagen[]   @relation("ImagenesCurso")
  // F14: el de la voz que lee las frases de escuchar y repetir, uno de IDIOMAS_CURSO (un
  // CHECK de la migración f14_escuchar_repetir). Los cursos de antes quedaron en "es"
  idioma        String     @default("es")
  audios        Audio[]    @relation("AudiosCurso")
  // F08: si quien lo completa gana una insignia; lo cambia su autor en un borrador
  daInsignia     Boolean       @default(false) @map("da_insignia")
  insignias      Insignia[]
  // F16: metadatos de exploración, visibilidad flexible, fork y silo opcional
  categoria      String        @default("otros")
  nivel          String        @default("principiante")
  etiquetas      String[]      @default([])
  visibilidad    String        @default("publico") // "publico" | "enlacePrivado" | "organizacion"
  claveEnlace    String?       @unique @map("clave_enlace")
  idOrganizacion String?       @map("id_organizacion")
  organizacion   Organizacion? @relation(fields: [idOrganizacion], references: [id], onDelete: SetNull)
  tambienPublico Boolean       @default(false) @map("tambien_publico")
  permiteFork    Boolean       @default(true) @map("permite_fork")
  idCursoOrigen  String?       @map("id_curso_origen")
  cursoOrigen    Curso?        @relation("ForkCurso", fields: [idCursoOrigen], references: [id], onDelete: SetNull)
  bifurcaciones  Curso[]       @relation("ForkCurso")
  grupos         Grupo[]
  reportes       ReporteActividad[]

  @@index([idAutor])
  @@index([idOrganizacion])
  @@index([categoria, nivel])
  @@map("curso")
}

model Leccion {
  id            String             @id @default(uuid(7))
  idCurso       String             @map("id_curso")
  curso         Curso              @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  titulo        String
  // F16: agrupación pedagógica opcional en módulos o unidades
  modulo        String?
  posicion      Int // 1, 2, 3, ... dentro del curso
  // F03: lista de Actividad del contrato, en orden; solo se escribe después de validarActividades
  actividades   Json               @default("[]")
  // sube cada vez que se guarda la lección; reordenar no la cambia (spec F05)
  version       Int                @default(1)
  // F13: los ids de las imágenes que usan sus actividades, sin repetir. Lo escribe
  // guardarLeccion; así "se usa en el curso" no tiene que leer el JSON
  imagenes      String[]           @default([])
  // F14: lo mismo con los audios
  audios        String[]           @default([])
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")
  progresos     Progreso[] // F04 (no crea columnas)
  reportes      ReporteActividad[] // F16

  @@unique([idCurso, posicion])
  @@map("leccion")
}

// ---------------------------------------------------------------------------
// Progreso (F04): a lo sumo una fila por alumno y lección, con el resultado de
// la última vez que la completó. La migración agrega un CHECK
// (0 <= aciertos <= preguntas) que Prisma no sabe declarar.
// ---------------------------------------------------------------------------

model Progreso {
  idUsuario    String   @map("id_usuario")
  usuario      User     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  idLeccion    String   @map("id_leccion")
  leccion      Leccion  @relation(fields: [idLeccion], references: [id], onDelete: Cascade)
  aciertos     Int
  preguntas    Int
  // la última vez que la completó: ordena "Mis cursos" y "Sigue aprendiendo"
  completadaEn DateTime @default(now()) @map("completada_en")
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@id([idUsuario, idLeccion])
  @@index([idLeccion])
  @@map("progreso")
}

// ---------------------------------------------------------------------------
// Imagen (F13): un archivo de imagen de un curso, con sus bytes (decisión 0016). Nunca
// cambia: otro archivo es otra imagen. La migración agrega los CHECK de formato, lados y
// peso, que Prisma no sabe declarar. Las consultas de metadatos nunca piden `datos`.
// ---------------------------------------------------------------------------

model Imagen {
  id               String   @id @default(uuid(7))
  idCurso          String   @map("id_curso")
  curso            Curso    @relation("ImagenesCurso", fields: [idCurso], references: [id], onDelete: Cascade)
  // SHA-256 de `datos`: el mismo archivo subido dos veces al mismo curso es la misma imagen
  huella           String
  formato          String // jpeg, png, webp o gif (FORMATOS_IMAGEN)
  ancho            Int
  alto             Int
  peso             Int // bytes, igual a la longitud de `datos`
  datos            Bytes
  // se renueva si se sube otra vez el mismo archivo; decide cuándo se borra si nada la usa
  subidaEn         DateTime @default(now()) @map("subida_en")
  cursosConPortada Curso[]  @relation("PortadaCurso")

  @@unique([idCurso, huella])
  @@map("imagen")
}

// ---------------------------------------------------------------------------
// Audio (F14): un archivo de audio de un curso, con sus bytes ya sin datos ocultos
// (decisión 0017). Sigue las reglas de Imagen: nunca cambia, el mismo archivo es el mismo
// audio, y las consultas de metadatos nunca piden `datos`. La migración agrega el CHECK de
// formato, duración y peso, que Prisma no sabe declarar.
// ---------------------------------------------------------------------------

model Audio {
  id       String   @id @default(uuid(7))
  idCurso  String   @map("id_curso")
  curso    Curso    @relation("AudiosCurso", fields: [idCurso], references: [id], onDelete: Cascade)
  // SHA-256 de `datos`, el audio ya limpio: dos archivos que solo cambian en su título son
  // el mismo audio
  huella   String
  formato  String // mp3, m4a o wav (FORMATOS_AUDIO)
  duracion Int // milisegundos
  peso     Int // bytes, igual a la longitud de `datos`
  datos    Bytes
  // se renueva si se sube otra vez el mismo audio; decide cuándo se borra si nada lo usa
  subidaEn DateTime @default(now()) @map("subida_en")

  @@unique([idCurso, huella])
  @@map("audio")
}

// F08: un usuario completó un curso que daba insignia. Una por usuario y curso; no se
// pierde si el curso cambia, pero se borra con el curso (como el progreso).
model Insignia {
  idUsuario String   @map("id_usuario")
  usuario   User     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  idCurso   String   @map("id_curso")
  curso     Curso    @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  ganadaEn  DateTime @default(now()) @map("ganada_en")

  @@id([idUsuario, idCurso])
  @@index([idCurso])
  @@map("insignia")
}

// ---------------------------------------------------------------------------
// F16 (decisión 0020): Silos opcionales (Organizaciones / Espacios), Aulas y
// reportes de error en actividades.
// ---------------------------------------------------------------------------

model Organizacion {
  id                 String                @id @default(uuid(7))
  slug               String                @unique
  nombre             String
  descripcion        String                @default("")
  colorMarca         String?               @map("color_marca")
  // "abierto" | "codigo" | "dominio"
  modoAcceso         String                @default("codigo") @map("modo_acceso")
  codigoAcceso       String?               @unique @map("codigo_acceso")
  dominiosPermitidos String[]              @default([]) @map("dominios_permitidos")
  requiereRevision   Boolean               @default(false) @map("requiere_revision")
  creadoEn           DateTime              @default(now()) @map("creado_en")
  actualizadoEn      DateTime              @updatedAt @map("actualizado_en")
  miembros           MiembroOrganizacion[]
  cursos             Curso[]
  grupos             Grupo[]

  @@map("organizacion")
}

model MiembroOrganizacion {
  idOrganizacion String       @map("id_organizacion")
  organizacion   Organizacion @relation(fields: [idOrganizacion], references: [id], onDelete: Cascade)
  idUsuario      String       @map("id_usuario")
  usuario        User         @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  // "dueno" | "admin" | "docente" | "alumno"
  rol            String       @default("alumno")
  unidoEn        DateTime     @default(now()) @map("unido_en")

  @@id([idOrganizacion, idUsuario])
  @@index([idUsuario])
  @@map("miembro_organizacion")
}

model Grupo {
  id             String        @id @default(uuid(7))
  codigo         String        @unique
  nombre         String
  idCurso        String        @map("id_curso")
  curso          Curso         @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  idDocente      String        @map("id_docente")
  docente        User          @relation(fields: [idDocente], references: [id], onDelete: Cascade)
  idOrganizacion String?       @map("id_organizacion")
  organizacion   Organizacion? @relation(fields: [idOrganizacion], references: [id], onDelete: SetNull)
  creadoEn       DateTime      @default(now()) @map("creado_en")
  miembros       MiembroGrupo[]

  @@index([idDocente])
  @@index([idCurso])
  @@map("grupo")
}

model MiembroGrupo {
  idGrupo   String   @map("id_grupo")
  grupo     Grupo    @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  idUsuario String   @map("id_usuario")
  usuario   User     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  unidoEn   DateTime @default(now()) @map("unido_en")

  @@id([idGrupo, idUsuario])
  @@index([idUsuario])
  @@map("miembro_grupo")
}

model ReporteActividad {
  id              String   @id @default(uuid(7))
  idCurso         String   @map("id_curso")
  curso           Curso    @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  idLeccion       String   @map("id_leccion")
  leccion         Leccion  @relation(fields: [idLeccion], references: [id], onDelete: Cascade)
  indiceActividad Int      @map("indice_actividad")
  idUsuario       String   @map("id_usuario")
  usuario         User     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  mensaje         String
  resuelto        Boolean  @default(false)
  creadoEn        DateTime @default(now()) @map("creado_en")

  @@index([idCurso, resuelto])
  @@map("reporte_actividad")
}

