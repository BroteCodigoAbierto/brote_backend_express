// Esquema de la base de datos de Brote.
// Los modelos se agregan con el plan de cada feature (ver brote_specs).
// Convención: modelos y campos en español; tablas y columnas en snake_case
// con @@map y @map.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generado/prisma"
  // el código generado se importa como .ts, igual que el resto de la API
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth (F01). ÚNICA EXCEPCIÓN a los nombres en español: estos cuatro
// modelos se quedan como los define Better Auth 1.7 para no mantener un mapeo
// de campos con cada versión (ver brote_specs, plan de F01, "Excepciones").
// El contrato los traduce: User → Usuario (name → nombre, email → correo).
// ---------------------------------------------------------------------------

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  cursos        Curso[] // F02: cursos de los que es autor (no crea columnas)
  progresos     Progreso[] // F04: lecciones completadas (no crea columnas)

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Forma de entrar de un usuario; en el MVP solo "credential" (correo y contraseña)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Better Auth la exige aunque F01 no la usa (verificar correo, recuperar contraseña)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Cursos (F02) y actividades de las lecciones (F03). Los límites del título
// y la descripción llegan con F05.
// ---------------------------------------------------------------------------

model Curso {
  id            String    @id @default(uuid(7))
  titulo        String
  descripcion   String
  // solo los publicados se ven; lo pone en true un administrador en la base (decisión
  // 0014), y en false también su autor, al retirarlo del catálogo (F06)
  publicado     Boolean   @default(false)
  // F06: null, "pendiente" o "rechazada". Un trigger de la base limpia estos dos
  // campos cuando cambia `publicado`, y un CHECK valida sus valores (no se ven
  // aquí: están en la migración f06_revision_curso)
  revision      String?
  motivoRechazo String?   @map("motivo_rechazo")
  idAutor       String    @map("id_autor")
  // borrar cuentas está fuera del MVP: un autor con cursos no se puede borrar
  autor         User      @relation(fields: [idAutor], references: [id], onDelete: Restrict)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  lecciones     Leccion[]
  // F13: una de sus imágenes, que no sea GIF (lo comprueba el servicio). Si la imagen se
  // borra, el curso se queda con la portada generada
  idPortada     String?   @map("id_portada")
  portada       Imagen?   @relation("PortadaCurso", fields: [idPortada], references: [id], onDelete: SetNull)
  imagenes      Imagen[]  @relation("ImagenesCurso")

  @@index([idAutor])
  @@map("curso")
}

model Leccion {
  id            String     @id @default(uuid(7))
  idCurso       String     @map("id_curso")
  curso         Curso      @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  titulo        String
  posicion      Int // 1, 2, 3, ... dentro del curso
  // F03: lista de Actividad del contrato, en orden; solo se escribe después de validarActividades
  actividades   Json       @default("[]")
  // sube cada vez que se guarda la lección; reordenar no la cambia (spec F05)
  version       Int        @default(1)
  // F13: los ids de las imágenes que usan sus actividades, sin repetir. Lo escribe
  // guardarLeccion; así "se usa en el curso" no tiene que leer el JSON
  imagenes      String[]   @default([])
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")
  progresos     Progreso[] // F04 (no crea columnas)

  @@unique([idCurso, posicion])
  @@map("leccion")
}

// ---------------------------------------------------------------------------
// Progreso (F04): a lo sumo una fila por alumno y lección, con el resultado de
// la última vez que la completó. La migración agrega un CHECK
// (0 <= aciertos <= preguntas) que Prisma no sabe declarar.
// ---------------------------------------------------------------------------

model Progreso {
  idUsuario    String   @map("id_usuario")
  usuario      User     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  idLeccion    String   @map("id_leccion")
  leccion      Leccion  @relation(fields: [idLeccion], references: [id], onDelete: Cascade)
  aciertos     Int
  preguntas    Int
  // la última vez que la completó: ordena "Mis cursos" y "Sigue aprendiendo"
  completadaEn DateTime @default(now()) @map("completada_en")
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@id([idUsuario, idLeccion])
  @@index([idLeccion])
  @@map("progreso")
}

// ---------------------------------------------------------------------------
// Imagen (F13): un archivo de imagen de un curso, con sus bytes (decisión 0016). Nunca
// cambia: otro archivo es otra imagen. La migración agrega los CHECK de formato, lados y
// peso, que Prisma no sabe declarar. Las consultas de metadatos nunca piden `datos`.
// ---------------------------------------------------------------------------

model Imagen {
  id               String   @id @default(uuid(7))
  idCurso          String   @map("id_curso")
  curso            Curso    @relation("ImagenesCurso", fields: [idCurso], references: [id], onDelete: Cascade)
  // SHA-256 de `datos`: el mismo archivo subido dos veces al mismo curso es la misma imagen
  huella           String
  formato          String // jpeg, png, webp o gif (FORMATOS_IMAGEN)
  ancho            Int
  alto             Int
  peso             Int // bytes, igual a la longitud de `datos`
  datos            Bytes
  // se renueva si se sube otra vez el mismo archivo; decide cuándo se borra si nada la usa
  subidaEn         DateTime @default(now()) @map("subida_en")
  cursosConPortada Curso[]  @relation("PortadaCurso")

  @@unique([idCurso, huella])
  @@map("imagen")
}
