# Copia este archivo como .env y ajusta los valores.

PUERTO=3000

# URL pública de la API (por defecto http://localhost:<PUERTO>)
URL_API=http://localhost:3000

# Secreto con el que se firman las sesiones: al menos 32 caracteres.
# Genera uno con:  openssl rand -base64 32
SECRETO_AUTH=

# Orígenes del navegador que pueden llamar a la API (la web en desarrollo)
ORIGENES_PERMITIDOS=http://localhost:5173

# Coincide con compose.yaml
DATABASE_URL="postgresql://brote:brote@localhost:5432/brote?schema=public"
